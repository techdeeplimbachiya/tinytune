## Train
Prints the baseline score, then the score after each epoch. About 10–15 minutes on a T4.
!python scripts/train.py --epochs 2 --train-samples 4000 --eval-samples 1000
import json
r = json.load(open('outputs/tinytune-distilbert-imdb/results.json'))
print('Baseline  :', r['baseline'])
print('Fine-tuned:', r['final'])
print('Trainable :', r['params'])
## Push to the Hugging Face Hub (optional)
Create a **write** token at huggingface.co/settings/tokens, then replace `YOUR_USERNAME` below.
from huggingface_hub import notebook_login
notebook_login()
!python scripts/train.py --push-to-hub --hub-repo-id YOUR_USERNAME/tinytune-distilbert-imdb
